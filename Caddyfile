:{$PORT:80} {
	@oldEmailProtection {
		header Host astro.magicsort.online
		path /cdn-cgi/l/email-protection
	}
	redir @oldEmailProtection https://magicsort.online/contact/ 308

	@emailProtection path /cdn-cgi/l/email-protection
	redir @emailProtection /contact/ 308

	@oldHost header Host astro.magicsort.online
	redir @oldHost https://magicsort.online{uri} 308

	@www header_regexp host Host ^www\.(.+)$
	redir @www https://{re.host.1}{uri} 308

	# Serve one public URL for the core routes reported with slash and non-slash variants.
	@missingTrailingSlash path /play /games /how-to-play /strategy /difficulty-guide /game-mechanics /blog /parents /faq /about /editorial-policy /contact /accessibility /privacy-policy /cookie-policy /terms /disclaimer /dmca /sitemap /magic-sort-help
	redir @missingTrailingSlash {http.request.uri.path}/ 308

	@missingNestedTrailingSlash path_regexp missingNestedTrailingSlash ^/(blog|games)/([^/.]+)$
	redir @missingNestedTrailingSlash /{re.missingNestedTrailingSlash.1}/{re.missingNestedTrailingSlash.2}/ 308

	@gameDocument path /game/ /game/index.html
	header @gameDocument {
		Cache-Control "no-cache, must-revalidate"
		X-Robots-Tag "noindex, nofollow"
	}

	@versionedGameAssets path /game/assets/* /game/css/* /game/js/*
	header @versionedGameAssets Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; frame-src 'self' https://playgama.com https://*.playgama.com https://playgamead.com https://www.googletagmanager.com; base-uri 'self'; form-action 'self'; object-src 'none'"
	}

	root * {$SITE_ROOT:dist}
	encode gzip zstd
	try_files {path} {path}/index.html {path}.html
	file_server
}
