---
import { GAME_ASSET_VERSION } from "@/data/gameVersion";

type Props = {
  title?: string;
};

const { title = "Play Magic Sort online" } = Astro.props;
const challengeParam = Astro.url.searchParams.get("challenge");
const challengeToken = challengeParam && /^[A-Za-z0-9_-]{1,500}$/.test(challengeParam) ? challengeParam : "";
const iframeSrc = `/game/index.html?v=${GAME_ASSET_VERSION}${challengeToken ? `&challenge=${challengeToken}` : ""}`;
---

<div class="play-shell" data-game-embed>
  <div class="game-embed-stage">
    <iframe src={iframeSrc} title={title} loading="eager" allow="autoplay; fullscreen *" allowfullscreen></iframe>
    <div class="game-embed-loading" data-game-loading role="status" aria-label="Loading Magic Sort">
      <div class="game-embed-loading__mark" aria-hidden="true">
        <span class="game-embed-loading__vial">
          <span class="game-embed-loading__liquid"></span>
          <span class="game-embed-loading__bubble game-embed-loading__bubble--one"></span>
          <span class="game-embed-loading__bubble game-embed-loading__bubble--two"></span>
        </span>
      </div>
    </div>
  </div>
  <div class="play-float-controls">
    <button type="button" data-share-game aria-label="Challenge a friend">Challenge</button>
    <button type="button" data-fullscreen-game aria-label="Enter fullscreen" aria-pressed="false">Fullscreen</button>
  </div>
  <p class="play-share-feedback" data-share-feedback aria-live="polite"></p>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll("[data-game-embed]:not([data-game-ready])").forEach((shell) => {
      shell.setAttribute("data-game-ready", "false");
      const iframe = shell.querySelector("iframe");
      const fullscreen = shell.querySelector("[data-fullscreen-game]");
      const share = shell.querySelector("[data-share-game]");
      const feedback = shell.querySelector("[data-share-feedback]");
      const isMobileShare = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      let shareRequest = 0;
      let pseudoFullscreen = false;
      let savedScrollPosition = 0;
      let shellPlaceholder = null;

      const nativeFullscreenElement = () => document.fullscreenElement || document.webkitFullscreenElement;
      const shouldUsePseudoFullscreen = () => isMobileShare || window.matchMedia("(max-width: 900px)").matches;

      const updateFullscreenControl = () => {
        const active = pseudoFullscreen || nativeFullscreenElement() === shell;
        fullscreen?.setAttribute("aria-pressed", String(active));
        fullscreen?.setAttribute("aria-label", active ? "Exit fullscreen" : "Enter fullscreen");
        if (fullscreen) fullscreen.textContent = active ? "Exit" : "Fullscreen";
      };

      const updateMobileFullscreenViewport = () => {
        const viewport = window.visualViewport;
        const width = viewport?.width || window.innerWidth;
        const height = viewport?.height || window.innerHeight;
        const offsetLeft = viewport?.offsetLeft || 0;
        const offsetTop = viewport?.offsetTop || 0;
        shell.style.setProperty("--game-fullscreen-width", `${Math.round(width)}px`);
        shell.style.setProperty("--game-fullscreen-height", `${Math.round(height)}px`);
        shell.style.setProperty("--game-fullscreen-left", `${Math.round(offsetLeft)}px`);
        shell.style.setProperty("--game-fullscreen-top", `${Math.round(offsetTop)}px`);
      };

      const enterPseudoFullscreen = () => {
        savedScrollPosition = window.scrollY;
        pseudoFullscreen = true;
        shellPlaceholder = document.createComment("game-embed-placeholder");
        shell.parentNode?.insertBefore(shellPlaceholder, shell);
        document.body.appendChild(shell);
        updateMobileFullscreenViewport();
        shell.classList.add("is-pseudo-fullscreen");
        document.documentElement.classList.add("game-pseudo-fullscreen");
        updateFullscreenControl();
      };

      const exitPseudoFullscreen = () => {
        if (!pseudoFullscreen) return;
        pseudoFullscreen = false;
        if (document.activeElement instanceof HTMLElement && shell.contains(document.activeElement)) {
          document.activeElement.blur();
        }
        shell.classList.remove("is-pseudo-fullscreen");
        document.documentElement.classList.remove("game-pseudo-fullscreen");
        if (shellPlaceholder?.parentNode) {
          shellPlaceholder.parentNode.insertBefore(shell, shellPlaceholder);
          shellPlaceholder.remove();
        }
        shellPlaceholder = null;
        shell.style.removeProperty("--game-fullscreen-width");
        shell.style.removeProperty("--game-fullscreen-height");
        shell.style.removeProperty("--game-fullscreen-left");
        shell.style.removeProperty("--game-fullscreen-top");
        window.scrollTo(0, savedScrollPosition);
        window.requestAnimationFrame(() => window.scrollTo(0, savedScrollPosition));
        updateFullscreenControl();
      };

      const requestNativeFullscreen = shell.requestFullscreen || shell.webkitRequestFullscreen;
      const exitNativeFullscreen = document.exitFullscreen || document.webkitExitFullscreen;

      const setFeedback = (message) => {
        if (!feedback) return;
        feedback.textContent = message;
        feedback.classList.add("is-visible");
        window.clearTimeout(setFeedback.timer);
        setFeedback.timer = window.setTimeout(() => feedback.classList.remove("is-visible"), 3200);
      };

      const markReady = (event) => {
        if (event.source !== iframe?.contentWindow || event.data?.type !== "magic-sort-ready") return;
        shell.setAttribute("data-game-ready", "true");
      };

      const requestChallenge = () => new Promise((resolve) => {
        const requestId = `share-${Date.now()}-${++shareRequest}`;
        const timer = window.setTimeout(() => {
          window.removeEventListener("message", receive);
          resolve(null);
        }, 900);
        const receive = (event) => {
          if (event.source !== iframe?.contentWindow || event.data?.type !== "magic-sort-share-data" || event.data.requestId !== requestId) return;
          window.clearTimeout(timer);
          window.removeEventListener("message", receive);
          resolve(event.data.data ?? null);
        };
        window.addEventListener("message", receive);
        iframe?.contentWindow?.postMessage({ type: "magic-sort-share-request", requestId }, location.origin);
      });

      const copyText = async (value) => {
        try {
          await Promise.race([
            navigator.clipboard.writeText(value),
            new Promise((_, reject) => window.setTimeout(() => reject(new Error("clipboard timeout")), 800)),
          ]);
          return true;
        } catch {
          const input = document.createElement("textarea");
          input.value = value;
          input.setAttribute("readonly", "");
          input.style.position = "fixed";
          input.style.opacity = "0";
          document.body.appendChild(input);
          input.select();
          const copied = document.execCommand("copy");
          input.remove();
          return copied;
        }
      };

      window.addEventListener("message", markReady);
      fullscreen?.addEventListener("click", async () => {
        if (pseudoFullscreen) {
          exitPseudoFullscreen();
          return;
        }
        if (nativeFullscreenElement()) {
          await exitNativeFullscreen?.call(document);
          return;
        }
        if (shouldUsePseudoFullscreen()) {
          enterPseudoFullscreen();
          return;
        }
        if (!requestNativeFullscreen) {
          enterPseudoFullscreen();
          return;
        }
        try {
          await requestNativeFullscreen.call(shell, { navigationUI: "hide" });
          updateFullscreenControl();
        } catch {
          enterPseudoFullscreen();
        }
      });
      document.addEventListener("fullscreenchange", updateFullscreenControl);
      document.addEventListener("webkitfullscreenchange", updateFullscreenControl);
      window.visualViewport?.addEventListener("resize", () => {
        if (pseudoFullscreen) updateMobileFullscreenViewport();
      });
      window.visualViewport?.addEventListener("scroll", () => {
        if (pseudoFullscreen) updateMobileFullscreenViewport();
      });
      window.addEventListener("orientationchange", () => {
        if (pseudoFullscreen) window.setTimeout(updateMobileFullscreenViewport, 120);
      });
      window.addEventListener("pagehide", exitPseudoFullscreen);
      share?.addEventListener("click", async () => {
        const challenge = await requestChallenge();
        const url = new URL("/play/", location.origin);
        if (challenge?.token) url.searchParams.set("challenge", challenge.token);
        const target = challenge?.target;
        const text = target
          ? `I cleared Magic Sort stage ${challenge.level} in ${target.moves} moves. Can you beat it?`
          : "Try this Magic Sort puzzle and see if you can beat it.";
        const data = { title: "Magic Sort Challenge", text, url: url.href };
        try {
          if (isMobileShare && navigator.share) {
            await navigator.share(data);
            return;
          }
          const copied = await copyText(url.href);
          setFeedback(copied ? (challenge?.token ? "Challenge link copied." : "Game link copied.") : "Copy this link: " + url.href);
        } catch {
          setFeedback("Copy this link: " + url.href);
        }
      });
    });
  })();
</script>
