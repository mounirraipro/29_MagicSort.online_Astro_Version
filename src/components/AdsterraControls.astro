---
import { adsterra, adsterraSocialPaths } from "@/data/adsterra";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const editorial = adsterraSocialPaths.includes(path) || path.startsWith("/blog/");
---

{adsterra.enabled && (
  <section class="adsterra-preferences" aria-label="Adsterra advertising preferences" id="adsterra-preferences" data-adsterra-preferences data-social-bar={editorial}>
    {adsterra.smartlink.enabled && (
      <p><a href={adsterra.smartlink.href} target="_blank" rel="sponsored nofollow noopener noreferrer">Sponsored offer — external advertisement (opens a new tab)</a></p>
    )}
    <details>
      <summary>Adsterra ad preferences</summary>
      <p>Adsterra ads load automatically where eligible, subject to your saved preference and Global Privacy Control. They may use cookies and process your IP address, device and browsing information for advertising. <a href="/privacy-policy/#adsterra-privacy">Privacy details</a></p>
      <p data-adsterra-status role="status"></p>
      <label><input type="checkbox" data-adsterra-opt-out /> Hide Adsterra ads on this browser</label>
      <p>Changing this setting reloads the page and may interrupt an unfinished puzzle. Google analytics settings are unchanged.</p>
    </details>
  </section>
  <script>
    import { initializeAdsterra } from "@/scripts/adsterra";
    initializeAdsterra();
  </script>
)}

<style>
  .adsterra-preferences { width: min(1120px, calc(100% - 48px)); margin: 2rem auto; padding-block: 1rem; color: #475569; font: .875rem/1.6 system-ui; }
  p { margin: .75rem 0; }
  a { color: #6d28d9; text-decoration: underline; }
  summary { cursor: pointer; font-weight: 700; }
  label { display: inline-flex; align-items: center; gap: .5rem; cursor: pointer; }
</style>
