---
import { adsterra } from "@/data/adsterra";
type Props = { unit: "leaderboard" | "skyscraper" };
const { unit } = Astro.props;
const config = adsterra[unit];
const minViewport = unit === "leaderboard" ? 1024 : 1200;
---

{adsterra.enabled && config.enabled && (
  <aside class:list={["adsterra-banner", `adsterra-${unit}`]} aria-label="Advertisement" data-adsterra-banner data-key={config.key} data-width={config.width} data-height={config.height} data-min-viewport={minViewport} hidden>
    <span>Advertisement</span>
    <div class="adsterra-slot" style={`width:${config.width}px;height:${config.height}px`}></div>
  </aside>
)}

<style>
  .adsterra-banner { margin: 2rem auto; max-width: 100%; text-align: center; }
  .adsterra-banner[hidden] { display: none; }
  .adsterra-banner > span { display: block; margin-bottom: .5rem; color: #64748b; font: .75rem/1.5 system-ui; }
  .adsterra-slot { margin-inline: auto; }
  .adsterra-leaderboard { width: min(1120px, calc(100% - 48px)); }
  @media (max-width: 1023px) { .adsterra-leaderboard { display: none; } }
  @media (max-width: 1199px) { .adsterra-skyscraper { display: none; } }
</style>
