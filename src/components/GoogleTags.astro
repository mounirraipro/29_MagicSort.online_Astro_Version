---
type Props = {
  gtmId?: string;
};

const {
  gtmId = import.meta.env.PUBLIC_GTM_ID || "GTM-TBJVHRC5",
} = Astro.props;

const gtmHeadSnippet = `(function(w,d,s,l,i){if(!/^(?:www\\.)?magicsort\\.online$/.test(w.location.hostname))return;w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${gtmId}');`;
---

{gtmId && <script is:inline set:html={gtmHeadSnippet}></script>}
